# Grok text generation and figure analysis.
XAI_API_KEY=your_xai_api_key_here
GROK_TEXT_MODEL=grok-4.7
GROK_VISION_MODEL=grok-4.7
FRONTEND_ORIGINS=https://your-site.vercel.app

# Optional model and local settings
# Required only to run the optional RAGAS evaluation script.
GROQ_API_KEY=your_groq_api_key_for_evaluation
GROQ_EVAL_MODEL=openai/gpt-oss-20b
GROQ_RESUME_MODEL=openai/gpt-oss-120b
VISION_CONCURRENCY=4
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_PDF_UPLOADS_PER_STUDENT=5
SYNAPSE_UPLOAD_DB_PATH=data/upload_limits.sqlite3
SYNAPSE_MATERIALS_PATH=uploaded_materials
SYNAPSE_CHROMA_DB_PATH=chroma_db
# SYNAPSE_LEARNER_PROFILE_PATH=backend/student_analytics/learner_state.json
MAX_RESUME_SIZE_MB=10
SYNAPSE_RESUME_DB_PATH=data/resume_analyzer.sqlite3
SYNAPSE_RESUME_FILES_PATH=data/resumes
